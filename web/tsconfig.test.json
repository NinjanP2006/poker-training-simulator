{
  // Type-checks the Vitest files. Same settings as the app, plus Node's types
  // (tests run in Node and read the .wasm file from disk).
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}
