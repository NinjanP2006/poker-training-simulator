{
  // Type-checks the Playwright tests. Node settings, plus the DOM library for
  // code that runs inside the page (page.waitForFunction callbacks).
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
